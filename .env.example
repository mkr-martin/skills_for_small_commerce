# 키 이름 목록 — 이 파일이 원본이다(shared/setup_keys.py 가 이 파일에서 키 이름을 읽어 창을 띄운다).
# 보통은 이 파일을 직접 고치지 않는다: 클로드에게 "키 넣어줘" → 뜨는 창에 붙여넣기 → 루트 .env 에 저장된다.
# .env 는 .gitignore 에 들어 있어 올라가지 않는다. 키를 채팅창·문서·스크린샷에 남기지 않는다.
# 발급 방법 = README "키 발급" 절. 키 없이 쓰는 스킬: ⓪ 반자동크롤러 · ① 상세페이지 분석
# 주석에 "(선택)" 이 붙은 키는 창으로 묻지 않는다(필요할 때만 직접).

# ── ② 릴스 레퍼런스 — Google AI Studio API 키
GEMINI_API_KEY=
# (선택) 분석 모델을 바꾸고 싶을 때만. 비워 두면 스킬 기본값
GEMINI_MODEL=

# ── ③ 문의 모으기 · ④ 매대 점검 — 네이버 커머스API센터 애플리케이션 ID · 시크릿
NAVER_COMMERCE_CLIENT_ID=
NAVER_COMMERCE_CLIENT_SECRET=

# ── ③ 문의 모으기 · ④ 매대 점검 — 쿠팡 윙 OPEN API (업체코드 = A 또는 C로 시작)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_VENDOR_ID=

# ── ③ 문의 모으기 · ④ 매대 점검 — 카페24 개발자센터 앱
# 쇼핑몰 ID = 관리자 로그인 아이디(xxx.cafe24.com 의 xxx)
CAFE24_MALL_ID=
# 앱의 Client ID · Client Secret
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
# 앱 설정에 적은 Redirect URI 와 글자 하나까지 같게(로그인 후 돌아올 주소)
CAFE24_REDIRECT_URI=
# (선택) ③ 문의를 모을 게시판 번호(쉼표로 여러 개, 예: 6,9) — 로그인 뒤 fetch.py --cafe24-boards 로 번호를 보고 적는다
CAFE24_INQUIRY_BOARDS=
# 접근 토큰은 여기 적지 않는다 — 카페24 로그인(python3 shared/channels/cafe24.py login)이
# 레포 루트 cafe24.token.json 에 저장하고 2주 동안 자동 연장한다. 권한(SCOPES)이 바뀌면 로그인을 다시.
